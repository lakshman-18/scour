{
  "name": "scour-cli",
  "version": "0.5.0",
  "description": "Read and search anything on the internet for $0. Reddit, X, YouTube, GitHub, docs, PDFs and any web page as clean Markdown. CLI, MCP server and Firecrawl-compatible API.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "scour": "./bin/scour.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "ui",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build",
    "smoke": "node test/smoke.mjs",
    "compat": "node test/firecrawl-compat.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "commander": "^15.0.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.5",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "turndown": "^7.2.0",
    "undici": "^8.12.1",
    "unpdf": "^1.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mendable/firecrawl-js": "^4.46.0",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "scraper",
    "crawler",
    "web-scraping",
    "mcp",
    "mcp-server",
    "ai-agents",
    "llm",
    "markdown",
    "firecrawl-alternative",
    "reddit",
    "twitter",
    "youtube-transcript",
    "pdf",
    "rss",
    "claude"
  ],
  "author": "Lakshman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakshman-18/scour.git"
  },
  "homepage": "https://github.com/lakshman-18/scour#readme",
  "bugs": {
    "url": "https://github.com/lakshman-18/scour/issues"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
